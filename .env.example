# ---------------------------------------------------------------------------
# Media Studio configuration.  Copy to .env (scripts/setup.py does this for you).
# Every setting is optional - the defaults work on a Mac mini out of the box.
# ---------------------------------------------------------------------------

# --- Network ---------------------------------------------------------------
MEDIA_HOST=127.0.0.1          # 0.0.0.0 to reach it from other devices (then a token is REQUIRED)
MEDIA_PORT=8090

# --- Access ----------------------------------------------------------------
# Leave empty for single-user use on this computer. Set a long random value when the
# service is reachable by others or called by Enfactum OS / Enfactum AI.
MEDIA_API_TOKEN=
# Hosts allowed to receive job-finished webhooks (comma separated). Empty = webhooks disabled.
MEDIA_CALLBACK_HOSTS=
# Browser origins allowed to call the API cross-site (comma separated). Empty = same-origin only.
MEDIA_CORS_ORIGINS=

# --- Storage ---------------------------------------------------------------
MEDIA_DATA_DIR=./data
MEDIA_MODEL_CACHE=./data/models
MEDIA_RETENTION_DAYS=0        # delete finished items older than N days (0 = keep forever)

# --- Models ----------------------------------------------------------------
# auto = real models if PyTorch is installed and there is enough memory, otherwise demo mode
MEDIA_IMAGE_BACKEND=auto      # auto | flux2 | mock
MEDIA_VIDEO_BACKEND=auto      # auto | ltx-video | ltx-2.5 (experimental, 64GB+) | mock
IMAGE_MODEL_ID=black-forest-labs/FLUX.2-klein-4B
VIDEO_MODEL_ID=Lightricks/LTX-Video
LTX25_MODEL_ID=Lightricks/LTX-2.5-Diffusers
MEDIA_DEVICE=auto             # auto | mps | cuda | cpu
MEDIA_DTYPE=auto              # auto | bfloat16 | float16 | float32
MEDIA_LOW_MEMORY=             # empty = decide from hardware; 1 = save memory (slower); 0 = off

# --- Limits ----------------------------------------------------------------
MEDIA_MAX_CONCURRENT_HEAVY_JOBS=1   # keep 1 on Apple Silicon
MEDIA_QUEUE_SIZE=32
MEDIA_MAX_UPLOAD_MB=25
MEDIA_MAX_VIDEO_UPLOAD_MB=300
MEDIA_MAX_IMAGE_PIXELS=4194304
MEDIA_MAX_VIDEO_PIXELS=921600
MEDIA_MAX_VIDEO_FRAMES=241

# Hugging Face token, only if a model repository asks you to accept terms / log in:
# HF_TOKEN=
